# Copy to pi/.env and edit. Restart the server after changes.

# HTTP bind. Use 0.0.0.0 so the laptop can reach the Pi over WiFi/hotspot.
CAMERA_HOST=0.0.0.0
CAMERA_PORT=8000

# Force the synthetic camera even on a real Pi (useful for UI work without the sensor).
CAMERA_MOCK=0

# Viewfinder stream (IR). Keep this low-res; JPEG encoding is CPU-bound on the Pi.
PREVIEW_WIDTH=1280
PREVIEW_HEIGHT=720
STREAM_FPS=15
JPEG_QUALITY=80

# Full-resolution still captured on shutter (5MP NoIR sensor).
STILL_WIDTH=2592
STILL_HEIGHT=1944

# GPIO pins (BCM numbering). See docs in README "Hardware wiring".
LED_IR_PIN=17
LED_WHITE_PIN=27
SHUTTER_PIN=18
SHUTTER_ENABLED=1

# How long the white LED is on for the colour still (pupil constricts after this).
WHITE_FLASH_MS=450
# Settle time after switching LEDs before grabbing a frame.
IR_SETTLE_MS=120
WHITE_SETTLE_MS=150

# Where captured stills are written on the Pi.
CAPTURES_DIR=captures
