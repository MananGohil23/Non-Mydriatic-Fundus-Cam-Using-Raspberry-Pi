# Copy to pi/.env and edit. Restart the server after changes.

# HTTP bind. Use 0.0.0.0 so the laptop can reach the Pi over WiFi/hotspot.
CAMERA_HOST=0.0.0.0
CAMERA_PORT=8000

# Force the synthetic camera even on a real Pi (useful for UI work without the sensor).
CAMERA_MOCK=0

# Viewfinder stream (IR). Keep this low-res; JPEG encoding is CPU-bound on the Pi.
PREVIEW_WIDTH=1280
PREVIEW_HEIGHT=720
STREAM_FPS=15
JPEG_QUALITY=80

# Full-resolution still captured on shutter (5MP NoIR sensor).
STILL_WIDTH=2592
STILL_HEIGHT=1944

# GPIO pins (BCM numbering). See README "Hardware wiring".
LED_IR_PIN=27
LED_WHITE_PIN=22
SHUTTER_PIN=17
SHUTTER_ENABLED=1
SHUTTER_BOUNCE_S=0.03

# LED drive polarity. 1 = GPIO HIGH turns the LED on (NPN low-side switch, default).
# Set to 0 if your driver is active-low (PNP / P-channel MOSFET / many relay boards),
# which otherwise leaves an LED permanently lit.
LED_ACTIVE_HIGH=1
# LED_IR_ACTIVE_HIGH=
# LED_WHITE_ACTIVE_HIGH=

# Capture light sequence, matching the reference tap-switch sketch:
#   IR off -> wait WHITE_SETTLE_MS -> white on -> wait WHITE_FLASH_MS -> capture -> IR on
WHITE_SETTLE_MS=100
WHITE_FLASH_MS=200
IR_SETTLE_MS=50

# Where captured stills are written on the Pi.
CAPTURES_DIR=captures
