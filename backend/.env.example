# Copy to backend/.env and edit. Restart uvicorn after changes.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Where the Raspberry Pi camera server is reachable.
# Same WiFi/hotspot: use the Pi's IP, e.g. http://192.168.1.50:8000
# Phone hotspot demo: find it with `hostname -I` on the Pi.
CAMERA_BASE_URL=http://raspberrypi.local:8000

# "remote" talks to CAMERA_BASE_URL, "mock" runs a synthetic camera in-process.
CAMERA_MODE=remote

# "stub" returns plausible results with no model. "retfound" loads the checkpoint below.
INFER_MODE=stub

# Fine-tuned RETFound CFP checkpoint (.pth saved by main_finetune.py).
CHECKPOINT_PATH=
MODEL_ARCH=vit_large_patch16
NUM_CLASSES=2
CLASS_NAMES=normal,referable
INPUT_SIZE=224

# Image quality gate run before the model (blur / exposure / framing).
QUALITY_ENABLED=1
BLUR_THRESHOLD=35
BRIGHTNESS_MIN=18
BRIGHTNESS_MAX=245

# Comma-separated origins for CORS, or * during the hackathon.
CORS_ORIGINS=*

# Seconds to wait on the Pi for capture / health.
CAMERA_TIMEOUT=20
